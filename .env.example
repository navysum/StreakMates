# Copy this to .env ONCE, then fill in the two values below and save.
# Re-running `cp .env.example .env` overwrites whatever you filled in.
#
# Both values are safe to ship in the app bundle — the anon key only ever
# grants what your row-level security policies allow.
#
# Find them in Supabase under Project Settings -> API.
#
# The URL is NOT the dashboard address you browse to. It looks like
# https://<project-ref>.supabase.co — not https://supabase.com/dashboard/...
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sign in with Apple. Leave unset until there is an Apple Developer account:
# the provider cannot be configured in Supabase without one, so the button
# would only ever show an error. Set to 1 once Apple is switched on under
# Authentication -> Providers.
# EXPO_PUBLIC_APPLE_SIGN_IN=1
